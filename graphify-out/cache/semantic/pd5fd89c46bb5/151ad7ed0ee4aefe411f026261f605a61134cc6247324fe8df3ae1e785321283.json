{"nodes": [{"id": "agents_skills_graphify_references_query", "label": "Query/Path/Explain Reference (.agents)", "file_type": "document", "source_file": ".agents/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_graphify_references_query_vocab_expansion", "label": "Constrained Query Vocabulary Expansion", "file_type": "concept", "source_file": ".agents/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify's query matcher is case-folded substring + IDF with no stemming, synonyms, or cross-language matching, so a wording mismatch between the user's question and the graph's node-label vocabulary collapses the answer to noise; the fix is to extract the graph's actual label vocabulary first and pick only real vocab tokens (never invented ones) before traversal."}, {"id": "agents_skills_graphify_references_query_work_memory", "label": "Work Memory / Self-Improving Loop", "file_type": "concept", "source_file": ".agents/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "save-result --outcome useful|dead_end|corrected builds preferred sources and known dead ends into graphify-out/reflections/LESSONS.md via `graphify reflect`, so later sessions start by reading lessons instead of re-deriving the same dead-end queries."}], "edges": [{"source": "agents_skills_graphify_references_query", "target": "agents_skills_graphify_references_hooks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/graphify/references/query.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_graphify_references_query", "target": "agents_skills_graphify_references_query_vocab_expansion", "relation": "impleme