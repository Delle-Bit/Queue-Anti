# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Uploaded patient files (IDs, images)
uploads/

# Environment secrets
.env

# Runtime artifacts (written by hand when starting the server detached)
server_pid.txt

# The browser preview tool resolves .claude/launch.json against the working
# directory, so running it from .claude/ makes a nested copy here.
.claude/.claude/

# Python bytecode - the UI/UX skill ships Python helpers that get compiled.
__pycache__/
*.pyc

# Agent/tooling scratch directories.
.superpowers/
.claude/.playwright-mcp/

# Graphify output. The whole directory is regenerated by `graphify update .`
# (cache, dated backups and the graph itself), so it is not committed - run the
# command after changing code to rebuild it locally.
graphify-out/
