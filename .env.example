# Copy to .env and fill in. Never commit the real .env - it is gitignored.
#
#   cp .env.example .env
#
# Only PORT and JWT_SECRET are genuinely required. Everything else has a working
# default or degrades gracefully, so the app boots with nothing else set.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# The clinic's timezone. This is not cosmetic: ticket numbers are minted per
# station per DAY (CURDATE()), and the walk-in dashboard filters on
# DATE(started_at) = CURDATE(). A container defaults to UTC, which for a
# Philippine clinic would roll the date over at 08:00 local - resetting the
# day's ticket counters in the middle of the morning session. Set the database's
# timezone to match (DB_TIME_ZONE below).
TZ=Asia/Manila

# Logs every socket connect/disconnect when set to 1. Off by default: one socket
# per open page means ordinary use fills the terminal with pairs that say
# nothing about anything.
# LOG_SOCKETS=1

# REQUIRED. Signs the 8-hour session tokens. Use a long random string and change
# it for every environment - rotating it invalidates all existing logins.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The password every seeded account is CREATED with. Leave blank locally: the
# per-account defaults (pass123 / admin123 / owner123) are what
# example_accounts.md documents and what you already use.
#
# SET IT in anything with a URL. Those defaults are published in this public
# repository, so on a fresh deployed database "owner1" / "owner123" is a working
# administrator login for whoever finds the site. It applies at creation only -
# a password you change from the admin UI afterwards is never overwritten, and
# is not affected by redeploys.
# SEED_PASSWORD=

# ── Database (MySQL) ──────────────────────────────────────────────────────────
# Defaults match a stock local XAMPP/MySQL install. The app creates the database
# and all tables on first boot, and auto-migrates schema changes on later boots,
# so there is nothing to import by hand. The account below therefore needs
# CREATE DATABASE on first run - on managed MySQL where that is not granted,
# create the database yourself and the app will just build the tables inside it.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=clinic_v2
DB_CONNECTION_LIMIT=10

# TLS. Most managed MySQL providers require it and will refuse a plaintext
# connection; a database on the same machine or the same Docker network does
# not need it.
#   true         verify the server certificate against the system CA store
#   skip-verify  encrypt but do not verify - for a self-signed certificate on a
#                trusted network only, never over the open internet
# DB_SSL=true
# Some providers issue their own CA instead. Paste the certificate itself here,
# not a path to it.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----"

# How long to wait for the database at boot before giving up and exiting
# non-zero. Defaults are 15 attempts, 2 seconds apart. This is what lets
# `docker compose up` start the app and MySQL together: MySQL takes a while to
# become reachable on a cold volume, and the app waits instead of crash-looping.
# DB_CONNECT_RETRIES=15
# DB_CONNECT_DELAY_MS=2000

# ── Docker Compose only ───────────────────────────────────────────────────────
# Ignored when running `npm start` directly; read by docker-compose.yml. See
# DOCKER.md.

# REQUIRED by compose. The MySQL root password for the database container.
# The app never uses this - it connects as DB_USER above.
# DB_ROOT_PASSWORD=

# Host port to publish the app on. The container always listens on 3000; change
# this if 3000 is already taken on the host machine.
# APP_PORT=3000

# The database container's timezone, as a MySQL offset. Keep this in agreement
# with TZ above, or the app and the database will disagree about what day it is.
# DB_TIME_ZONE=+08:00

# ── AI features (all optional) ────────────────────────────────────────────────
# OCR-assisted registration, the Virtual Nurse Assistant and the analytics
# helpers try these in order and fall back to local mock logic, so the app is
# fully usable with none of them set.
GEMINI_API_KEY=

# Spare Gemini keys, tried in order when the one above is refused for quota.
# A free-tier key has a per-minute and a per-day request limit; the per-day one
# ends OCR for the rest of the day, and a registration desk in a morning rush
# is exactly when it runs out. Slots _2 to _5 exist; a comma-separated
# GEMINI_API_KEY works too, if one long line suits you better than four
# variables.
GEMINI_API_KEY_2=

# Model overrides. Both default to gemini-3.6-flash. Google has retired
# gemini-2.5-flash for keys issued recently ("no longer available to new
# users"), so a key that works will 404 against it - which is worth knowing
# before blaming the key.
# GEMINI_CHAT_MODEL=
# GEMINI_OCR_MODEL=

API_ALLAROUND=
NVIDIA_API_KEY=

# Path to the OCR helper script. Only set this if you move the file; it also
# requires Python with pytesseract installed to do anything.
# PYTESSERACT_SCRIPT=

# ── Email: password reset (optional) ──────────────────────────────────────────
# Template needs the variables `to_email` and `reset_link`.
# Without these, reset links are only printed to the server console as
# [MOCK EMAIL TO ...] instead of being sent.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ── Customer login OTP (better-auth) ──────────────────────────────────────────
# Signs the six-digit code exchange for the customer login second factor. The
# app falls back to JWT_SECRET when this is unset, so there is no configuration
# in which it runs on better-auth's own published default - but set it anyway to
# keep the two apart: this one signs an OTP exchange, JWT_SECRET signs every
# session in the system.
# BETTER_AUTH_SECRET=

# The public base URL of the deployment, used when constructing the OTP flow.
# Defaults to http://localhost:<PORT>, which is fine locally. On a deployment,
# set it to the real address (e.g. https://your-app.up.railway.app).
# BETTER_AUTH_URL=

# ── Email: OTP codes (optional) ───────────────────────────────────────────────
# Registration verification and login OTPs. Deliberately a separate EmailJS
# service/template from the password-reset one above.
# Template needs the variables `to_email` and `otp_code`.
EMAILJS_OTP_SERVICE_ID=
EMAILJS_OTP_TEMPLATE_ID=
EMAILJS_OTP_PUBLIC_KEY=
EMAILJS_OTP_PRIVATE_KEY=
